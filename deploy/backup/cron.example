# Beispiel-Crontab fuer den Bank-Workflow-Backup-Host.
# Auf den Server uebertragen via:  crontab /opt/bws/deploy/backup/cron.example
# Voraussetzung: Skripte sind unter /opt/bws/deploy/backup/ ausfuehrbar (chmod +x).

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# Logik-Datenbank (SQLite-Snapshot): 02:00 Uhr (UTC).
0  2 * * *  /opt/bws/deploy/backup/sqlite_backup.sh   >> /var/log/bws-backup.log 2>&1

# Datei-Anhaenge: 02:30 Uhr (UTC).
30 2 * * *  /opt/bws/deploy/backup/storage_backup.sh  >> /var/log/bws-backup.log 2>&1

# Aufbewahrung: alles ab 30 Tagen taeglich loeschen.
0  4 * * *  find /backups -name 'bws-sqlite-*.db'        -mtime +30 -delete >> /var/log/bws-backup.log 2>&1
0  4 * * *  find /backups -name 'bws-attachments-*.tar.gz' -mtime +30 -delete >> /var/log/bws-backup.log 2>&1
