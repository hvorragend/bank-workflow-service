# Beispiel fuer deploy/.env. Lokale Kopie:
#   cp deploy/.env.example deploy/.env
# Oder einfacher (generiert echte Zufallswerte):
#   ./deploy/bootstrap-env.sh
#
# deploy/.env wird per .gitignore vom Repo ausgeschlossen.

# ============================================================================
# WICHTIG: Jeder mit "replace-..." beginnende Wert MUSS ersetzt werden, sonst
# startet der Backend-Container nicht und der Reverse-Proxy liefert 502 fuer
# alle Requests (auch /auth/login).
# ============================================================================

# JWT_SECRET — mindestens 32 Byte Zufall, Format: 64 Hex-Zeichen.
# Erzeugen mit:
#   openssl rand -hex 32
# Beispiel-Format (NICHT diesen Wert nehmen):
#   JWT_SECRET=4f1c2b9a8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a
JWT_SECRET=replace-with-openssl-rand-hex-32

# CONFIG_ENCRYPTION_KEY — symmetrischer Schluessel fuer SMTP-/LDAP-Passwoerter
# in der DB. Pflicht. Format: GENAU 44 Zeichen, url-safe Base64, endet auf '='.
# !!! Das ist NICHT dasselbe Format wie JWT_SECRET (hex). Nicht verwechseln. !!!
# Erzeugen mit:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Beispiel-Format (NICHT diesen Wert nehmen):
#   CONFIG_ENCRYPTION_KEY=kHs9pP3YtXp5Lq0qN2mR7vW8eA1bC4dF6gI3jK5lM7o=
CONFIG_ENCRYPTION_KEY=replace-with-fernet-generate-key-output

# Optional: alter Schluessel als Decrypt-Fallback waehrend einer Schluessel-Rotation.
# Workflow: NEW_KEY setzen, OLD_KEY fuer eine Phase parallel halten, im Admin-Panel
# „Schluessel-Rotation" ausfuehren, OLD_KEY entfernen, neu starten.
# CONFIG_ENCRYPTION_KEY_OLD=

# Notfall-Admin (Break-Glass). Wird NUR geladen, wenn die DB unerreichbar ist
# oder kein aktiver Admin in der users-Tabelle existiert. Lege im Container
# eine kleine config/emergency_users.json an (siehe config/emergency_users.example.json).
EMERGENCY_USERS_PATH=config/emergency_users.json

# Initial-Admin fuer die Erstinbetriebnahme (Greenfield). Wird nur angelegt,
# wenn weder ein Admin in der DB noch eine Notfall-Datei existiert. Ohne
# INITIAL_ADMIN_PASSWORD wird ein Einmal-Passwort generiert und im Container
# unter /app/data/initial-admin-password.txt abgelegt (dev-up.sh/prod-up.sh
# zeigen es an). Nach dem ersten Login: Passwort im Admin-Panel aendern.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# ============================================================================
# Sicherheits- und Betriebs-Schalter (F-025/F-026).
# Die hier gezeigten Werte sind DEV-Defaults. Die Prod-Werte stehen daneben und
# sind in deploy/README.md ("Produktions-Haertung") zusammengefasst.
# ============================================================================

# Refresh-Token-Cookie nur ueber HTTPS senden (Secure-Flag).
#   Dev (http://localhost): false
#   Prod (TLS davor):       true   <-- unbedingt setzen
REFRESH_COOKIE_SECURE=false

# Erlaubte CORS-Origins, komma-separiert. Leer/nicht gesetzt = sichere
# Code-Defaults (http://localhost:8000, http://localhost:5173).
# Prod: exakte Frontend-Origin(s) eintragen, z. B.:
#   CORS_ALLOW_ORIGINS=https://workflow.example-bank.de
# '*' (Wildcard) nur bewusst und niemals zusammen mit Cookies verwenden.
CORS_ALLOW_ORIGINS=

# Fiktive Demo-Antraege beim ersten Start seeden. In PRODUKTION NIE setzen —
# erfundene "genehmigte" Antraege haben in einem revisionsrelevanten System
# nichts zu suchen. Zum Ausschalten: Variable leer lassen oder weglassen.
#   Dev (optional):  SEED_DEMO_DATA=1
SEED_DEMO_DATA=

# X-Forwarded-For app-seitig auswerten (fuer Audit-IP / Rate-Limiter). NUR
# setzen, wenn der Service NICHT mit uvicorn --proxy-headers laeuft. Der
# mitgelieferte Container startet uvicorn bereits mit --proxy-headers, daher
# hier normalerweise leer lassen. Setzen nur hinter einem vertrauenswuerdigen
# Reverse-Proxy — sonst kann ein Client die Audit-Spur faelschen.
#   TRUST_PROXY_HEADERS=1
TRUST_PROXY_HEADERS=

# Uvicorn-Log-Level: critical | error | warning | info | debug | trace.
LOG_LEVEL=info

# Host-Bind-Adresse fuer den Web-Port (http, 8000). Default 0.0.0.0 = ueber die
# Host-IP erreichbar (funktioniert out-of-the-box, auch bei Fernzugriff auf einen
# Server). PROD-HAERTUNG: auf 127.0.0.1 setzen und einen TLS-Reverse-Proxy
# davorschalten, damit der Klartext-Port nicht direkt aus dem Netz erreichbar ist.
#   Prod: WEB_HTTP_BIND=127.0.0.1
WEB_HTTP_BIND=0.0.0.0
