# Produktions-aehnliches Beispiel fuer deploy/docker-compose.yml.
# Lokale Kopie: cp deploy/.env.example deploy/.env  und Werte anpassen.
# deploy/.env wird per .gitignore vom Repo ausgeschlossen.

PG_USER=bws
PG_PASSWORD=replace-me-in-production
PG_DB=bws

# JWT-Schluessel — mindestens 32 Bytes Zufall.
# Erzeugen mit:  openssl rand -hex 32
JWT_SECRET=replace-with-openssl-rand-hex-32

# local | ldap | both
AUTH_MODE=local

# Pfade (im Container relativ zum WORKDIR /app)
USERS_CONFIG_PATH=config/users.json
LDAP_CONFIG_PATH=config/ldap.toml
