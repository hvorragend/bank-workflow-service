# Cross-Platform-Konsistenz: alle Textdateien mit LF im Repo,
# Plattform-spezifische Skripte behalten ihre nativen Line-Endings.

* text=auto eol=lf

# Windows-spezifische Skripte (CRLF zwingend, sonst meckert cmd/PowerShell)
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Bekannte Binaerdateien — niemals als Text behandeln
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.woff  binary
*.woff2 binary
